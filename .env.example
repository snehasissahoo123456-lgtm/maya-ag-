# Copy to .env locally. Never commit real credentials.
MAYA_FOUNDER_EMAIL=snehasissahoo123456@gmail.com
MAYA_FOUNDER_PASSWORD=
GEMINI_API_KEY=
MAYA_TASK_WORKER_ENABLED=false
MAYA_TASK_WORKER_POLL_MS=3000
MAYA_TASK_WORKER_LEASE_MS=60000
MAYA_TASK_WORKER_MAX_TASKS_PER_CYCLE=20

# Persistent storage driver for conversations, goal plans, tasks, approvals, audit and memory: file (default) or supabase
MAYA_STORAGE_DRIVER=file
SUPABASE_URL=
# Server-only service role key. Never expose this to browser code or commit a real value.
SUPABASE_SERVICE_ROLE_KEY=

# Optional background goal-plan worker; single-instance file storage only
MAYA_PLAN_WORKER_ENABLED=false
MAYA_PLAN_WORKER_POLL_MS=3000
MAYA_PLAN_WORKER_MAX_PLANS_PER_CYCLE=10

# Optional recurring read-only workspace scheduler; requires task worker and file or migrated Supabase storage
MAYA_SCHEDULE_WORKER_ENABLED=false
MAYA_SCHEDULE_WORKER_POLL_MS=3000
MAYA_SCHEDULE_WORKER_MAX_JOBS_PER_CYCLE=10
